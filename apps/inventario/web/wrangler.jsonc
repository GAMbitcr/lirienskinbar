// Cloudflare Workers (solo archivos estáticos): sirve el build de dist/ con HTTPS en *.workers.dev.
// No hay código de servidor acá: la API es Apps Script y los datos viven en el Google Sheet.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lirien-inventario",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
